<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Faranou.Vendor.Host</RootNamespace>
    <AssemblyName>Faranou.Vendor.Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Development/StaticFiles/**/*">
      <LogicalName>Faranou.Vendor.Host.Development.StaticFiles.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <ProjectReference Include="..\Vendor.Persistence\Vendor.Persistence.csproj" />
    <ProjectReference Include="..\..\Licensing.Contracts\Licensing.Contracts.csproj" />
    <PackageReference Include="Pkcs11Interop" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Lets the test suite exercise the internal development provisioning helpers directly. -->
    <InternalsVisibleTo Include="Vendor.Host.Tests" />
  </ItemGroup>
</Project>
