<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep Microsoft EF Core and ASP.NET Core extension packages on the same servicing version. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Proxies" Version="9.0.21" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.21" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.21" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.21" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="9.0.21" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
