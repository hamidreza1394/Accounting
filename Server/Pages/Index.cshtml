@page
@model Server.Pages.IndexModel

@{
	var pageTitle =
		Resources.PageTitles.Index;

	ViewData[Constants.ViewDataKeyName.PageTitle] = pageTitle;
}

<partial name="PartialViews/_DisplayPageMessages" />

<div class="row">
	<div class="col">
		<h3>
			فرانو
		</h3>

		<hr />

		<p>
			@(string.Format(format: "خوش آمدید، {0}!", arg0: Model.FullName))
		</p>

		<p class="text-muted">
			نرم‌افزار حسابداری هوشمند — دسترسی امن به اطلاعات مالی شما
		</p>
	</div>
</div>

<hr />

<div class="row">
	<div class="col-md-6">
		<div class="card">
			<div class="card-header">
				حساب کاربری
			</div>

			<div class="card-body">
				<p class="mb-1">
					نام کاربری:
					<strong dir="ltr">@(Model.Username)</strong>
				</p>

				<p class="mb-0 text-muted">
					نشست شما با موفقیت احراز هویت شده است.
				</p>
			</div>
		</div>
	</div>

	<div class="col-md-6 mt-3 mt-md-0">
		<div class="card">
			<div class="card-header">
				شرکت‌های فعال
			</div>

			<div class="card-body">
				@if (Model.Companies.Count == 0)
				{
					<p class="mb-0 text-muted">
						در حال حاضر عضویت فعالی در شرکتی ندارید. دسترسی به اطلاعات هر شرکت تنها با عضویت معتبر و فعال در آن شرکت امکان‌پذیر است.
					</p>
				}
				else
				{
					<ul class="list-group list-group-flush">
						@foreach (var company in Model.Companies)
						{
							<li class="list-group-item px-0 d-flex justify-content-between align-items-center">
								<span>@(company.Name)</span>
								<span class="badge bg-secondary rounded-pill">@(company.RoleName)</span>
							</li>
						}
					</ul>
				}
			</div>
		</div>
	</div>
</div>
