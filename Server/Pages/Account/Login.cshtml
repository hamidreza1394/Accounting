@page
@model Server.Pages.Security.LoginModel
@{
    var isRightToLeft = System.Threading.Thread.CurrentThread.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData[Constants.ViewDataKeyName.PageTitle] = isRightToLeft ? "ورود به حساب" : "Sign In";
    ViewData["BodyClass"] = "taraz-login-page";
    Layout = isRightToLeft ? "Layouts/Rtl/_Security" : "Layouts/Ltr/_Security";

    var pageErrors = TempData[key: Infrastructure.Messages.MessageType.PageError.ToString()] as System.Collections.Generic.IList<string>;
    var pageWarnings = TempData[key: Infrastructure.Messages.MessageType.PageWarning.ToString()] as System.Collections.Generic.IList<string>;
    var pageSuccesses = TempData[key: Infrastructure.Messages.MessageType.PageSuccess.ToString()] as System.Collections.Generic.IList<string>;
}

@section StyleSheets {
    <link rel="stylesheet" href="~/css/rtl/taraz-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rtl/faranou-login-legacy-background.css" asp-append-version="true" />
}

<div class="taraz-login" dir="@(isRightToLeft ? "rtl" : "ltr")">
    <main class="taraz-login__shell" aria-labelledby="login-title">
        <section class="taraz-login__panel" aria-labelledby="login-title">
            <div class="taraz-panel-card">
                <div class="taraz-brand taraz-brand--form">
                    <div class="taraz-brand__row">
                        <div class="taraz-brand__text">
                            <p class="taraz-brand__name"><strong>فرانو</strong><span class="taraz-brand__latin" lang="en" dir="ltr">FARANOU</span></p>
                        </div>
                        <span class="fn-mark fn-mark--sm"><img src="~/images/faranou-logo-mark.svg" alt="" width="30" height="36" /></span>
                    </div>
                    <p class="taraz-brand__descriptor">@(isRightToLeft ? "نرم‌افزار حسابداری هوشمند" : "Smart Accounting Software")</p>
                </div>

                <div class="taraz-form-heading">
                    <p class="taraz-eyebrow">@(isRightToLeft ? "خوش آمدید" : "Welcome")</p>
                    <h1 id="login-title">@(isRightToLeft ? "ورود به حساب" : "Sign in to your account")</h1>
                </div>

                <form method="post" class="taraz-login-form" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="taraz-validation taraz-validation--summary" role="alert"></div>
                    <div class="taraz-form-status" role="status" aria-live="polite">
                        @if (pageErrors != null && pageErrors.Count != 0) { <div class="taraz-message taraz-message--error" role="alert"><ul class="mb-0">@foreach (var message in pageErrors) { <li>@message</li> }</ul></div> }
                        @if (pageWarnings != null && pageWarnings.Count != 0) { <div class="taraz-message taraz-message--warning"><ul class="mb-0">@foreach (var message in pageWarnings) { <li>@message</li> }</ul></div> }
                        @if (pageSuccesses != null && pageSuccesses.Count != 0) { <div class="taraz-message taraz-message--success"><ul class="mb-0">@foreach (var message in pageSuccesses) { <li>@message</li> }</ul></div> }
                    </div>

                    <div class="taraz-field">
                        <label asp-for="ViewModel.Username">@Resources.DataDictionary.Username</label>
                        <div class="taraz-input-wrap">
                            <input asp-for="ViewModel.Username" autocomplete="username" inputmode="text" placeholder="@(isRightToLeft ? "نام کاربری خود را وارد کنید" : "Enter your username")" autofocus />
                            <span class="taraz-input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
                        </div>
                        <span asp-validation-for="ViewModel.Username" class="taraz-field-error"></span>
                    </div>

                    <div class="taraz-field">
                        <label asp-for="ViewModel.Password">@Resources.DataDictionary.Password</label>
                        <div class="taraz-input-wrap">
                            <input asp-for="ViewModel.Password" class="taraz-input--with-action" autocomplete="current-password" placeholder="@(isRightToLeft ? "کلمه عبور خود را وارد کنید" : "Enter your password")" />
                            <button type="button" class="taraz-password-toggle" data-password-toggle="ViewModel_Password" data-label-show="@(isRightToLeft ? "نمایش رمز" : "Show password")" data-label-hide="@(isRightToLeft ? "پنهان کردن رمز" : "Hide password")" data-aria-show="@(isRightToLeft ? "نمایش رمز" : "Show password")" data-aria-hide="@(isRightToLeft ? "پنهان کردن رمز" : "Hide password")" aria-controls="ViewModel_Password" aria-label="@(isRightToLeft ? "نمایش رمز" : "Show password")" title="@(isRightToLeft ? "نمایش رمز" : "Show password")" aria-pressed="false"><span class="taraz-password-icon" data-password-icon aria-hidden="true"><svg class="taraz-eye taraz-eye--show" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><svg class="taraz-eye taraz-eye--hide" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M4 4l16 16"/></svg></span><span class="taraz-password-label" data-password-label>@(isRightToLeft ? "نمایش رمز" : "Show password")</span></button>
                        </div>
                        <span asp-validation-for="ViewModel.Password" class="taraz-field-error"></span>
                    </div>

                    <div class="taraz-form-row">
                        <label class="taraz-remember" asp-for="ViewModel.RememberMe"><input asp-for="ViewModel.RememberMe" /><span class="taraz-check" aria-hidden="true"></span><span>@Resources.DataDictionary.RememberMe</span></label>
                        <span class="taraz-chip"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l7.5 3v5.5c0 4.6-3.1 8.2-7.5 9.5-4.4-1.3-7.5-4.9-7.5-9.5V6z"/><path d="M9.2 12l2 2 3.8-4"/></svg>@(isRightToLeft ? "اتصال امن" : "Secure connection")</span>
                    </div>
                    <p class="taraz-security-note">@(isRightToLeft ? "فرانو فقط نام کاربری را ذخیره می‌کند، نه رمز عبور. برای ذخیره رمز عبور، پیشنهاد ذخیره‌سازی مرورگر را تأیید کنید." : "Faranou stores only your username, never your password. To save your password, accept your browser’s password-manager prompt.")</p>
                    <button type="submit" class="taraz-submit"><span class="taraz-submit-label">@Resources.ButtonCaptions.Login</span><span class="taraz-submit-status" hidden><span class="taraz-spinner" aria-hidden="true"></span>@(isRightToLeft ? "در حال بررسی..." : "Checking...")</span><span class="taraz-submit-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg></span></button>
                </form>
                <p class="taraz-support-note">@(isRightToLeft ? "در صورت فراموشی اطلاعات ورود یا بروز مشکل در ورود، با مدیر سامانه یا پشتیبانی تماس بگیرید." : "If you have forgotten your sign-in details or need help, contact the system administrator or support.")</p>
                <p class="taraz-security-note taraz-security-note--connection"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>@(isRightToLeft ? "ارتباط شما با سامانه به‌صورت امن برقرار می‌شود." : "Your connection to the system is secure.")</p>
            </div>
            <p class="taraz-copyright">© فرانو — @(isRightToLeft ? "نرم‌افزار حسابداری هوشمند" : "Smart Accounting Software")</p>
        </section>

        <section class="taraz-login__visual" aria-label="@(isRightToLeft ? "معرفی برند فرانو" : "Faranou brand introduction")">
            <partial name="PartialViews/_LoginBrandChart" />

            <div class="fn-brand-panel" inert>
                <div class="fn-brand-hero">
                    <div class="fn-brand-hero__row">
                        <div class="fn-brand-hero__title">
                            <h2 class="fn-brand-name">فرانو</h2>
                            <p class="fn-brand-latin" lang="en" dir="ltr">FARANOU</p>
                        </div>
                        <span class="fn-mark fn-mark--lg" aria-hidden="true"><img src="~/images/faranou-logo-mark.svg" alt="" width="62" height="75" /></span>
                    </div>
                    <p class="fn-brand-tagline">@(isRightToLeft ? "فرانو؛ فراتر از ایده‌ها، تا واقعیت" : "Faranou — Beyond ideas, into reality")</p>
                </div>

                <ul class="fn-benefits" role="list">
                    <li>
                        <span class="fn-benefit-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="27" height="27" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2.5"/><rect x="8" y="6" width="8" height="3.5" rx="0.8"/><path d="M8.5 13h.01M12 13h.01M15.5 13h.01M8.5 16.5h.01M12 16.5h.01M15.5 16.5h.01"/></svg>
                        </span>
                        <span class="fn-benefit-body">
                            <span class="fn-benefit-title">@(isRightToLeft ? "حسابداری دقیق و هوشمند" : "Precise, smart accounting")</span>
                            <span class="fn-benefit-text">@(isRightToLeft ? "ثبت دقیق، محاسبات هوشمند" : "Accurate recording, smart calculations")</span>
                        </span>
                    </li>
                    <li>
                        <span class="fn-benefit-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="27" height="27" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 9 9h-9z"/><path d="M15 3.6A9 9 0 0 1 20.4 9H15z"/></svg>
                        </span>
                        <span class="fn-benefit-body">
                            <span class="fn-benefit-title">@(isRightToLeft ? "مدیریت مالی یکپارچه" : "Unified financial management")</span>
                            <span class="fn-benefit-text">@(isRightToLeft ? "اتصال همه فرایندهای مالی در یک پلتفرم" : "All financial processes in one platform")</span>
                        </span>
                    </li>
                    <li>
                        <span class="fn-benefit-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="27" height="27" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><path d="M5 15l4-4 3 3 6-7"/><path d="M15 7h3v3"/></svg>
                        </span>
                        <span class="fn-benefit-body">
                            <span class="fn-benefit-title">@(isRightToLeft ? "گزارش‌های لحظه‌ای و تحلیلی" : "Live reports and analytics")</span>
                            <span class="fn-benefit-text">@(isRightToLeft ? "تصمیم‌گیری سریع با داده‌های واقعی" : "Faster decisions with real data")</span>
                        </span>
                    </li>
                    <li>
                        <span class="fn-benefit-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="27" height="27" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7.5 3v5.5c0 4.6-3.1 8.2-7.5 9.5-4.4-1.3-7.5-4.9-7.5-9.5V6z"/><rect x="9" y="10.5" width="6" height="5" rx="1.2"/><path d="M10.2 10.5V9a1.8 1.8 0 0 1 3.6 0v1.5"/></svg>
                        </span>
                        <span class="fn-benefit-body">
                            <span class="fn-benefit-title">@(isRightToLeft ? "امنیت بانکی و رمزنگاری پیشرفته" : "Banking-grade security and encryption")</span>
                            <span class="fn-benefit-text">@(isRightToLeft ? "حفاظت از داده‌ها در سطح استانداردهای جهانی" : "Data protected to international standards")</span>
                        </span>
                    </li>
                </ul>
            </div>
        </section>
    </main>
</div>

@section Scripts { <script src="~/js/taraz-login.js" asp-append-version="true"></script> }
