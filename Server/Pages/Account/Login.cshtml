@page
@model Server.Pages.Security.LoginModel
@{
    var isRightToLeft = System.Threading.Thread.CurrentThread.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData[Constants.ViewDataKeyName.PageTitle] = isRightToLeft ? "ورود به حساب" : "Sign In";
    ViewData["BodyClass"] = "taraz-login-page";
    Layout = isRightToLeft ? "Layouts/Rtl/_Security" : "Layouts/Ltr/_Security";

    var pageErrors = TempData[key: Infrastructure.Messages.MessageType.PageError.ToString()] as System.Collections.Generic.IList<string>;
    var pageWarnings = TempData[key: Infrastructure.Messages.MessageType.PageWarning.ToString()] as System.Collections.Generic.IList<string>;
    var pageSuccesses = TempData[key: Infrastructure.Messages.MessageType.PageSuccess.ToString()] as System.Collections.Generic.IList<string>;
}

@section StyleSheets {
    <link rel="stylesheet" href="~/css/rtl/taraz-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rtl/faranou-login-legacy-background.css" asp-append-version="true" />
}

<div class="taraz-login" dir="@(isRightToLeft ? "rtl" : "ltr")">
    <main class="taraz-login__shell" aria-labelledby="login-title">
        <section class="taraz-login__panel" aria-labelledby="login-title">
            <div class="taraz-panel-card">
                <div class="taraz-brand taraz-brand--form">
                    <img src="~/images/faranou-mark.svg" alt="" width="52" height="52" />
                    <div><strong>فرانو</strong><span>FARANOU — @(isRightToLeft ? "نرم‌افزار حسابداری هوشمند" : "Smart Accounting Software")</span></div>
                </div>

                <div class="taraz-form-heading">
                    <p class="taraz-eyebrow">@(isRightToLeft ? "خوش آمدید" : "Welcome")</p>
                    <h1 id="login-title">@(isRightToLeft ? "ورود به حساب" : "Sign in to your account")</h1>
                    <p>@(isRightToLeft ? "برای ادامه، نام کاربری و کلمه عبور خود را وارد کنید." : "Enter your username and password to continue.")</p>
                </div>

                <form method="post" class="taraz-login-form" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="taraz-validation taraz-validation--summary" role="alert"></div>
                    <div class="taraz-form-status" role="status" aria-live="polite">
                        @if (pageErrors != null && pageErrors.Count != 0) { <div class="taraz-message taraz-message--error" role="alert"><ul class="mb-0">@foreach (var message in pageErrors) { <li>@message</li> }</ul></div> }
                        @if (pageWarnings != null && pageWarnings.Count != 0) { <div class="taraz-message taraz-message--warning"><ul class="mb-0">@foreach (var message in pageWarnings) { <li>@message</li> }</ul></div> }
                        @if (pageSuccesses != null && pageSuccesses.Count != 0) { <div class="taraz-message taraz-message--success"><ul class="mb-0">@foreach (var message in pageSuccesses) { <li>@message</li> }</ul></div> }
                    </div>

                    <div class="taraz-field">
                        <label asp-for="ViewModel.Username">@Resources.DataDictionary.Username</label>
                        <div class="taraz-input-wrap">
                            <span class="taraz-input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
                            <input asp-for="ViewModel.Username" autocomplete="username" inputmode="text" placeholder="@(isRightToLeft ? "نام کاربری خود را وارد کنید" : "Enter your username")" autofocus />
                        </div>
                        <span asp-validation-for="ViewModel.Username" class="taraz-field-error"></span>
                    </div>

                    <div class="taraz-field">
                        <label asp-for="ViewModel.Password">@Resources.DataDictionary.Password</label>
                        <div class="taraz-input-wrap">
                            <span class="taraz-input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                            <input asp-for="ViewModel.Password" autocomplete="current-password" placeholder="@(isRightToLeft ? "کلمه عبور خود را وارد کنید" : "Enter your password")" />
                            <button type="button" class="taraz-password-toggle" data-password-toggle="ViewModel_Password" data-label-show="@(isRightToLeft ? "نمایش رمز" : "Show password")" data-label-hide="@(isRightToLeft ? "پنهان کردن رمز" : "Hide password")" data-aria-show="@(isRightToLeft ? "نمایش رمز" : "Show password")" data-aria-hide="@(isRightToLeft ? "پنهان کردن رمز" : "Hide password")" aria-controls="ViewModel_Password" aria-label="@(isRightToLeft ? "نمایش رمز" : "Show password")" title="@(isRightToLeft ? "نمایش رمز" : "Show password")" aria-pressed="false"><span class="taraz-password-icon" data-password-icon aria-hidden="true">◌</span><span data-password-label>@(isRightToLeft ? "نمایش رمز" : "Show password")</span></button>
                        </div>
                        <span asp-validation-for="ViewModel.Password" class="taraz-field-error"></span>
                    </div>

                    <label class="taraz-remember" asp-for="ViewModel.RememberMe"><input asp-for="ViewModel.RememberMe" /><span class="taraz-check" aria-hidden="true"></span><span>@Resources.DataDictionary.RememberMe</span></label>
                    <button type="submit" class="taraz-submit"><span class="taraz-submit-label">@Resources.ButtonCaptions.Login</span><span class="taraz-submit-status" hidden>@(isRightToLeft ? "در حال بررسی..." : "Checking...")</span><span class="taraz-submit-arrow" aria-hidden="true">←</span></button>
                </form>
                <p class="taraz-support-note">@(isRightToLeft ? "در صورت فراموشی اطلاعات ورود یا بروز مشکل در ورود، با مدیر سامانه یا پشتیبانی تماس بگیرید." : "If you have forgotten your sign-in details or need help, contact the system administrator or support.")</p>
                <p class="taraz-security-note"><span aria-hidden="true">🔒</span>@(isRightToLeft ? "ارتباط شما با سامانه به‌صورت امن برقرار می‌شود." : "Your connection to the system is secure.")</p>
            </div>
            <p class="taraz-copyright">© فرانو — @(isRightToLeft ? "نرم‌افزار حسابداری هوشمند" : "Smart Accounting Software")</p>
        </section>

        <section class="taraz-login__visual" aria-label="@(isRightToLeft ? "معرفی برند فرا نو و پیش‌نمایش نمایشی" : "Faranou brand introduction and illustrative preview")">
            <div class="fn-brand-panel" inert>
                <div class="fn-brand-hero">
                    <div class="fn-cloud-mark" aria-hidden="true">
                        <svg viewBox="0 0 120 88" width="96" height="70" focusable="false">
                            <defs>
                                <linearGradient id="fnCloudGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#e8f7fa"/>
                                    <stop offset="55%" stop-color="#b8e8ef"/>
                                    <stop offset="100%" stop-color="#7dd3de"/>
                                </linearGradient>
                                <linearGradient id="fnBarGrad" x1="0%" y1="100%" x2="0%" y2="0%">
                                    <stop offset="0%" stop-color="#2f8d93"/>
                                    <stop offset="100%" stop-color="#5ec4cc"/>
                                </linearGradient>
                                <linearGradient id="fnArrowGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#2f8d93"/>
                                    <stop offset="100%" stop-color="#e0a94a"/>
                                </linearGradient>
                            </defs>
                            <ellipse cx="58" cy="48" rx="42" ry="28" fill="url(#fnCloudGrad)" opacity="0.95"/>
                            <ellipse cx="38" cy="42" rx="22" ry="18" fill="url(#fnCloudGrad)"/>
                            <ellipse cx="78" cy="40" rx="26" ry="20" fill="url(#fnCloudGrad)"/>
                            <rect x="36" y="42" width="9" height="18" rx="2.5" fill="url(#fnBarGrad)"/>
                            <rect x="48" y="34" width="9" height="26" rx="2.5" fill="url(#fnBarGrad)"/>
                            <rect x="60" y="26" width="9" height="34" rx="2.5" fill="url(#fnBarGrad)"/>
                            <rect x="72" y="18" width="9" height="42" rx="2.5" fill="url(#fnBarGrad)"/>
                            <path d="M28 58 C40 52 52 44 68 28" fill="none" stroke="url(#fnArrowGrad)" stroke-width="3.2" stroke-linecap="round"/>
                            <polygon points="74,18 68,30 62,24" fill="#e0a94a"/>
                        </svg>
                    </div>
                    <h2 class="fn-brand-name">فرانو</h2>
                    <p class="fn-brand-tagline">@(isRightToLeft ? "فرانو؛ فراتر از ایده‌ها، تا واقعیت" : "Faranou — Beyond ideas, into reality")</p>
                    <p class="fn-brand-lead">@(isRightToLeft ? "مدیریت مالی کسب‌وکار خود را با دقت، نظم و اطمینان تجربه کنید." : "Experience precise, orderly and confident financial management for your business.")</p>
                </div>

                <ul class="fn-benefits" role="list">
                    <li>
                        <span class="fn-benefit-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>
                        </span>
                        <span>@(isRightToLeft ? "مدیریت مالی دقیق و هوشمند" : "Precise & smart financial management")</span>
                    </li>
                    <li>
                        <span class="fn-benefit-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3l7 4v5c0 5-3 8-7 9-4-1-7-4-7-9V7l7-4z"/><path d="M9.5 12l1.8 1.8L15 10"/></svg>
                        </span>
                        <span>@(isRightToLeft ? "حسابداری دقیق، تصمیم‌گیری مطمئن" : "Accurate accounting, confident decisions")</span>
                    </li>
                    <li>
                        <span class="fn-benefit-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 19V5M4 19h16"/><path d="M8 15l3-4 3 2 4-6"/></svg>
                        </span>
                        <span>@(isRightToLeft ? "نظم مالی، مسیر رشد کسب‌وکار" : "Financial order, path to growth")</span>
                    </li>
                    <li>
                        <span class="fn-benefit-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M7 18a5 5 0 0 1 0-10 6.5 6.5 0 0 1 12.4 2A4 4 0 0 1 18 18H7z"/></svg>
                        </span>
                        <span>@(isRightToLeft ? "ابزارهای یکپارچه برای مدیریت مالی" : "Integrated tools for financial management")</span>
                    </li>
                </ul>

                <div class="fn-dash" aria-hidden="true">
                    <div class="fn-dash-header">
                        <span class="fn-dash-header__title">@(isRightToLeft ? "نمای کلی مالی" : "Financial overview")</span>
                        <span class="fn-dash-header__badge">@(isRightToLeft ? "نمونه نمایشی" : "Preview only")</span>
                    </div>

                    <div class="fn-dash-cards">
                        <div class="fn-dash-card">
                            <div class="fn-dash-card__head">
                                <span>@(isRightToLeft ? "فروش امروز" : "Sales today")</span>
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H7"/></svg>
                            </div>
                            <div class="fn-dash-card__value">12,480,000</div>
                            <div class="fn-dash-card__trend">↑</div>
                        </div>
                        <div class="fn-dash-card">
                            <div class="fn-dash-card__head">
                                <span>@(isRightToLeft ? "دریافت‌ها" : "Receipts")</span>
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/></svg>
                            </div>
                            <div class="fn-dash-card__value">8,350,000</div>
                            <div class="fn-dash-card__trend">↑</div>
                        </div>
                        <div class="fn-dash-card">
                            <div class="fn-dash-card__head">
                                <span>@(isRightToLeft ? "پرداخت‌ها" : "Payments")</span>
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>
                            </div>
                            <div class="fn-dash-card__value">4,120,000</div>
                            <div class="fn-dash-card__trend">↑</div>
                        </div>
                    </div>

                    <div class="fn-dash-charts">
                        <div class="fn-dash-line">
                            <div class="fn-dash-line__title">@(isRightToLeft ? "روند فروش" : "Sales trend")</div>
                            <svg viewBox="0 0 280 96" width="100%" height="96" focusable="false">
                                <defs>
                                    <linearGradient id="fnLineFill" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#35d5e8" stop-opacity="0.32"/>
                                        <stop offset="100%" stop-color="#35d5e8" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <line x1="24" y1="16" x2="24" y2="76" stroke="rgba(255,255,255,0.10)" stroke-width="1"/>
                                <line x1="24" y1="76" x2="264" y2="76" stroke="rgba(255,255,255,0.10)" stroke-width="1"/>
                                <line x1="24" y1="46" x2="264" y2="46" stroke="rgba(255,255,255,0.06)" stroke-width="1" stroke-dasharray="4 4"/>
                                <path d="M24 70 L56 60 L88 54 L120 50 L152 42 L184 36 L216 28 L248 20 L264 14" fill="none" stroke="#35d5e8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M24 70 L56 60 L88 54 L120 50 L152 42 L184 36 L216 28 L248 20 L264 14 L264 76 L24 76 Z" fill="url(#fnLineFill)"/>
                                <circle cx="264" cy="14" r="4" fill="#e0a94a" stroke="#0a1f33" stroke-width="1.5"/>
                            </svg>
                        </div>
                        <div class="fn-dash-donut">
                            <div class="fn-dash-donut__title">@(isRightToLeft ? "توزیع سود" : "Profit mix")</div>
                            <div class="fn-dash-donut__body">
                                <svg viewBox="0 0 88 88" width="80" height="80" focusable="false">
                                    <circle cx="44" cy="44" r="30" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="11"/>
                                    <circle cx="44" cy="44" r="30" fill="none" stroke="#35d5e8" stroke-width="11" stroke-dasharray="126.0 62.2" stroke-dashoffset="0" transform="rotate(-90 44 44)"/>
                                    <circle cx="44" cy="44" r="30" fill="none" stroke="#e0a94a" stroke-width="11" stroke-dasharray="43.3 144.9" stroke-dashoffset="-126.0" transform="rotate(-90 44 44)"/>
                                    <circle cx="44" cy="44" r="30" fill="none" stroke="#7aa2c9" stroke-width="11" stroke-dasharray="18.8 169.4" stroke-dashoffset="-169.3" transform="rotate(-90 44 44)"/>
                                    <text x="44" y="42" text-anchor="middle" fill="#f5fbff" font-size="15" font-weight="700" font-family="IRANSansX, Tahoma, sans-serif">67%</text>
                                    <text x="44" y="56" text-anchor="middle" fill="#a9bfd1" font-size="8" font-family="IRANSansX, Tahoma, sans-serif">@(isRightToLeft ? "سود خالص" : "Net profit")</text>
                                </svg>
                                <ul class="fn-dash-legend">
                                    <li><i style="background:#35d5e8"></i>@(isRightToLeft ? "سود خالص ۶۷٪" : "Net 67%")</li>
                                    <li><i style="background:#e0a94a"></i>@(isRightToLeft ? "هزینه‌ها ۲۳٪" : "Costs 23%")</li>
                                    <li><i style="background:#7aa2c9"></i>@(isRightToLeft ? "سایر ۱۰٪" : "Other 10%")</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

@section Scripts { <script src="~/js/taraz-login.js" asp-append-version="true"></script> }
