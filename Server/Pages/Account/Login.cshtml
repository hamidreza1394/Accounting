@page
@model Server.Pages.Security.LoginModel
@{
    var isRightToLeft = System.Threading.Thread.CurrentThread.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData[Constants.ViewDataKeyName.PageTitle] = isRightToLeft ? "ورود به حساب" : "Sign In";
    ViewData["BodyClass"] = "taraz-login-page";
    Layout = isRightToLeft ? "Layouts/Rtl/_Security" : "Layouts/Ltr/_Security";

    // Page messages of this request (validation/auth status) are rendered inside the form card.
    // Note: the List cast is not reliable in every condition - same pattern as _DisplayPageMessages.
    var pageErrors =
        TempData[key: Infrastructure.Messages.MessageType.PageError.ToString()] as
        System.Collections.Generic.IList<string>;

    var pageWarnings =
        TempData[key: Infrastructure.Messages.MessageType.PageWarning.ToString()] as
        System.Collections.Generic.IList<string>;

    var pageSuccesses =
        TempData[key: Infrastructure.Messages.MessageType.PageSuccess.ToString()] as
        System.Collections.Generic.IList<string>;
}

@section StyleSheets {
    <link rel="stylesheet" href="~/css/rtl/taraz-login.css" asp-append-version="true" />
}

<div class="taraz-login" dir="@(isRightToLeft ? "rtl" : "ltr")">

    @* Two balanced desktop panels. The form is always on the physical right and the
       introduction panel always on the physical left (grid placement per direction).
       The form comes first in the markup so the keyboard and reading order start with it. *@
    <main class="taraz-login__shell" aria-labelledby="login-title">

        <section class="taraz-login__panel" aria-labelledby="login-title">
            <div class="taraz-panel-card">

                <div class="taraz-brand taraz-brand--form">
                    <img src="~/images/faranou-mark.svg" alt="" width="52" height="52" />
                    <div>
                        <strong>فرانو</strong>
                        <span>FARANOU — @(isRightToLeft ? "نرم‌افزار حسابداری هوشمند" : "Smart Accounting Software")</span>
                    </div>
                </div>

                <div class="taraz-form-heading">
                    <p class="taraz-eyebrow">@(isRightToLeft ? "خوش آمدید" : "Welcome")</p>
                    <h1 id="login-title">@(isRightToLeft ? "ورود به حساب" : "Sign in to your account")</h1>
                    <p>@(isRightToLeft ? "برای ادامه، نام کاربری و کلمه عبور خود را وارد کنید." : "Enter your username and password to continue.")</p>
                </div>

                <form method="post" class="taraz-login-form" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="taraz-validation taraz-validation--summary" role="alert"></div>

                    <div class="taraz-form-status" role="status" aria-live="polite">
                        @if (pageErrors != null && pageErrors.Count != 0)
                        {
                            <div class="taraz-message taraz-message--error" role="alert">
                                <ul class="mb-0">
                                    @foreach (var message in pageErrors)
                                    {
                                        <li>@(message)</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (pageWarnings != null && pageWarnings.Count != 0)
                        {
                            <div class="taraz-message taraz-message--warning">
                                <ul class="mb-0">
                                    @foreach (var message in pageWarnings)
                                    {
                                        <li>@(message)</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (pageSuccesses != null && pageSuccesses.Count != 0)
                        {
                            <div class="taraz-message taraz-message--success">
                                <ul class="mb-0">
                                    @foreach (var message in pageSuccesses)
                                    {
                                        <li>@(message)</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    <div class="taraz-field">
                        <label asp-for="ViewModel.Username">@Resources.DataDictionary.Username</label>
                        <div class="taraz-input-wrap">
                            <span class="taraz-input-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            </span>
                            <input asp-for="ViewModel.Username"
                                   autocomplete="username"
                                   inputmode="text"
                                   placeholder="@(isRightToLeft ? "نام کاربری خود را وارد کنید" : "Enter your username")"
                                   autofocus />
                        </div>
                        <span asp-validation-for="ViewModel.Username" class="taraz-field-error"></span>
                    </div>

                    <div class="taraz-field">
                        <label asp-for="ViewModel.Password">@Resources.DataDictionary.Password</label>
                        <div class="taraz-input-wrap">
                            <span class="taraz-input-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
                            </span>
                            <input asp-for="ViewModel.Password"
                                   autocomplete="current-password"
                                   placeholder="@(isRightToLeft ? "کلمه عبور خود را وارد کنید" : "Enter your password")" />
                            <button type="button"
                                    class="taraz-password-toggle"
                                    data-password-toggle="ViewModel_Password"
                                    data-label-show="@(isRightToLeft ? "نمایش" : "Show")"
                                    data-label-hide="@(isRightToLeft ? "پنهان‌کردن" : "Hide")"
                                    data-aria-show="@(isRightToLeft ? "نمایش کلمه عبور" : "Show password")"
                                    data-aria-hide="@(isRightToLeft ? "پنهان‌کردن کلمه عبور" : "Hide password")"
                                    aria-controls="ViewModel_Password"
                                    aria-label="@(isRightToLeft ? "نمایش کلمه عبور" : "Show password")"
                                    aria-pressed="false">
                                @(isRightToLeft ? "نمایش" : "Show")
                            </button>
                        </div>
                        <span asp-validation-for="ViewModel.Password" class="taraz-field-error"></span>
                    </div>

                    <label class="taraz-remember" asp-for="ViewModel.RememberMe">
                        <input asp-for="ViewModel.RememberMe" />
                        <span class="taraz-check" aria-hidden="true"></span>
                        <span>@Resources.DataDictionary.RememberMe</span>
                    </label>

                    <button type="submit" class="taraz-submit">
                        <span class="taraz-submit-label">@Resources.ButtonCaptions.Login</span>
                        <span class="taraz-submit-status" hidden>@(isRightToLeft ? "در حال بررسی..." : "Checking...")</span>
                        <span class="taraz-submit-arrow" aria-hidden="true">←</span>
                    </button>
                </form>

                <p class="taraz-support-note">
                    @(isRightToLeft
                        ? "در صورت فراموشی اطلاعات ورود یا بروز مشکل در ورود، با مدیر سامانه یا پشتیبانی تماس بگیرید."
                        : "If you have forgotten your sign-in details or need help, contact the system administrator or support.")
                </p>

                <p class="taraz-security-note">
                    <span aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.4-2.9 8.2-7 9-4.1-.8-7-4.6-7-9V6z" /></svg>
                    </span>
                    @(isRightToLeft ? "ارتباط شما با سامانه به‌صورت امن برقرار می‌شود." : "Your connection to the system is secure.")
                </p>
            </div>

            <p class="taraz-copyright">© فرانو — @(isRightToLeft ? "نرم‌افزار حسابداری هوشمند" : "Smart Accounting Software")</p>
        </section>

        <section class="taraz-login__visual" aria-label="@(isRightToLeft ? "معرفی نرم‌افزار حسابداری فرانو" : "Faranou accounting software")">

            <div class="taraz-visual-brand">
                <img src="~/images/faranou-logo.jpg"
                     alt="@(isRightToLeft ? "لوگوی فرانو — نرم‌افزار حسابداری هوشمند" : "Faranou logo — smart accounting software")"
                     width="360" height="197" />
            </div>

            <div class="taraz-visual-copy">
                <p class="taraz-eyebrow">نرم‌افزار حسابداری هوشمند</p>

                <h2 class="taraz-visual-title">دسترسی امن به اطلاعات مالی شما</h2>

                <ul class="taraz-features">
                    <li>
                        <span class="taraz-feature-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8" /><path d="M8.5 12.5l2.5 2.5 4.5-5" /></svg>
                        </span>
                        <span>دقت و شفافیت در مدیریت مالی</span>
                    </li>
                    <li>
                        <span class="taraz-feature-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16" /><path d="M6 16v-5" /><path d="M11 16V8" /><path d="M16 16v-7" /><path d="M20.5 7.5l-3-2-3 2" /></svg>
                        </span>
                        <span>حسابداری دقیق، تصمیم‌گیری مطمئن</span>
                    </li>
                </ul>
            </div>

            <div class="taraz-visual-chart" aria-hidden="true">
                <svg viewBox="0 0 560 240" role="presentation" focusable="false" preserveAspectRatio="xMidYMid meet">
                    <defs>
                        <linearGradient id="faranou-area" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0" stop-color="#2F8D93" stop-opacity=".22" />
                            <stop offset="1" stop-color="#2F8D93" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <g stroke="#D9DFE6" stroke-width="1">
                        <line x1="24" y1="40" x2="536" y2="40" />
                        <line x1="24" y1="100" x2="536" y2="100" />
                        <line x1="24" y1="160" x2="536" y2="160" />
                        <line x1="24" y1="210" x2="536" y2="210" />
                    </g>
                    <g fill="#E8C489">
                        <rect x="70" y="150" width="26" height="60" rx="5" />
                        <rect x="140" y="128" width="26" height="82" rx="5" />
                        <rect x="210" y="138" width="26" height="72" rx="5" />
                        <rect x="280" y="104" width="26" height="106" rx="5" />
                        <rect x="350" y="118" width="26" height="92" rx="5" />
                        <rect x="420" y="78" width="26" height="132" rx="5" />
                    </g>
                    <path d="M40 186 C110 170 150 176 200 150 S300 140 350 112 S450 96 520 56 L520 210 L40 210 Z" fill="url(#faranou-area)" />
                    <path d="M40 186 C110 170 150 176 200 150 S300 140 350 112 S450 96 520 56" fill="none" stroke="#2F8D93" stroke-width="5" stroke-linecap="round" />
                    <path d="M456 74 L520 56 L512 118" fill="none" stroke="#D9A24B" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>

        </section>
    </main>
</div>

@section Scripts {
    <script src="~/js/taraz-login.js" asp-append-version="true"></script>
}
