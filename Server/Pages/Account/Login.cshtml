@page
@model Server.Pages.Security.LoginModel
@{
    var pageTitle = "ورود به تراز آوا";
    ViewData[Constants.ViewDataKeyName.PageTitle] = pageTitle;
    Layout = "Layouts/Rtl/_Security";
}

<style>
    :root {
        --tara-navy-deep: #0a1e38;
        --tara-navy: #102B4E;
        --tara-navy-mid: #174C83;
        --tara-blue: #168CC7;
        --tara-cyan: #17B8C5;
        --tara-cyan-bright: #35D5E8;
        --tara-orange: #F2A65A;
        --tara-border: rgba(53, 213, 232, 0.18);
        --tara-text: #e8f4fc;
        --tara-muted: #8ba3bc;
        --tara-input-bg: rgba(10, 30, 56, 0.65);
    }

    body {
        margin: 0;
        background: var(--tara-navy-deep);
        font-family: Tahoma, "Segoe UI", system-ui, sans-serif;
    }

    .tara-login {
        min-height: 100vh;
        direction: rtl;
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(380px, 0.85fr);
        overflow: hidden;
        background:
            radial-gradient(ellipse 80% 60% at 15% 20%, rgba(23, 184, 197, 0.12), transparent 50%),
            radial-gradient(ellipse 70% 50% at 85% 75%, rgba(22, 140, 199, 0.15), transparent 45%),
            linear-gradient(160deg, #0a1e38 0%, #102B4E 40%, #0d2442 100%);
        color: var(--tara-text);
        position: relative;
    }

    .tara-login::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(53, 213, 232, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(53, 213, 232, 0.04) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(ellipse 80% 70% at 30% 40%, #000 20%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .tara-visual {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: clamp(24px, 4vw, 56px);
        min-height: 100vh;
    }

    .tara-brand {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 36px;
        color: #fff;
    }

    .tara-brand-logo {
        width: 72px;
        height: 72px;
        flex-shrink: 0;
        filter: drop-shadow(0 8px 24px rgba(53, 213, 232, 0.35));
    }

    .tara-brand-name {
        font-size: clamp(32px, 3.8vw, 48px);
        font-weight: 900;
        letter-spacing: -1px;
        line-height: 1.1;
        background: linear-gradient(135deg, #fff 0%, #a8e8f5 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .tara-brand-caption {
        font-size: 14px;
        color: var(--tara-muted);
        margin-top: 6px;
        font-weight: 500;
    }

    .tara-dashboard {
        position: relative;
        width: min(100%, 820px);
        padding: 22px;
        border-radius: 24px;
        background: linear-gradient(145deg, rgba(16, 43, 78, 0.85), rgba(10, 30, 56, 0.9));
        border: 1px solid var(--tara-border);
        box-shadow:
            0 32px 80px rgba(0, 0, 0, 0.45),
            0 0 0 1px rgba(53, 213, 232, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(20px);
        transform: perspective(1400px) rotateY(-4deg) rotateX(2deg);
        transition: transform 0.4s ease;
    }

    .tara-dashboard:hover {
        transform: perspective(1400px) rotateY(-2deg) rotateX(1deg);
    }

    .tara-dash-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(53, 213, 232, 0.12);
    }

    .tara-dash-title {
        font-size: 16px;
        font-weight: 800;
        color: #fff;
    }

    .tara-dash-sub {
        font-size: 12px;
        color: var(--tara-muted);
        margin-top: 4px;
    }

    .tara-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(53, 213, 232, 0.12);
        border: 1px solid rgba(53, 213, 232, 0.25);
        color: var(--tara-cyan-bright);
        font-size: 12px;
        font-weight: 700;
    }

    .tara-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 18px;
    }

    .tara-stat {
        padding: 14px 16px;
        border-radius: 16px;
        background: rgba(10, 30, 56, 0.55);
        border: 1px solid rgba(53, 213, 232, 0.1);
    }

    .tara-stat-label {
        font-size: 11px;
        color: var(--tara-muted);
        margin-bottom: 8px;
    }

    .tara-stat-value {
        font-size: clamp(15px, 1.5vw, 20px);
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.5px;
    }

    .tara-stat-change {
        font-size: 11px;
        color: #3dd68c;
        margin-top: 4px;
        font-weight: 600;
    }

    .tara-charts {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 14px;
    }

    .tara-chart-panel {
        padding: 16px;
        border-radius: 16px;
        background: rgba(10, 30, 56, 0.5);
        border: 1px solid rgba(53, 213, 232, 0.1);
    }

    .tara-chart-panel h4 {
        font-size: 13px;
        font-weight: 700;
        color: #c8e0f0;
        margin: 0 0 4px;
    }

    .tara-chart-panel p {
        font-size: 11px;
        color: var(--tara-muted);
        margin: 0 0 12px;
    }

    .tara-chart-svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .tara-footer-note {
        text-align: center;
        margin-top: 28px;
        font-size: 13px;
        color: var(--tara-muted);
    }

    .tara-footer-note span {
        color: var(--tara-cyan-bright);
    }

    .tara-form-side {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px clamp(20px, 4vw, 64px);
        background: linear-gradient(180deg, rgba(10, 30, 56, 0.4) 0%, rgba(16, 43, 78, 0.6) 100%);
        border-right: 1px solid rgba(53, 213, 232, 0.08);
    }

    .tara-card {
        width: min(100%, 420px);
        padding: clamp(28px, 3vw, 44px);
        border-radius: 24px;
        background: linear-gradient(160deg, rgba(16, 43, 78, 0.9), rgba(10, 30, 56, 0.95));
        border: 1px solid rgba(53, 213, 232, 0.2);
        box-shadow:
            0 24px 64px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(24px);
    }

    .tara-form-logo {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        display: block;
        filter: drop-shadow(0 6px 16px rgba(53, 213, 232, 0.3));
    }

    .tara-title {
        text-align: center;
        font-size: clamp(24px, 2.2vw, 30px);
        font-weight: 800;
        color: #fff;
        margin: 0 0 8px;
        letter-spacing: -0.5px;
    }

    .tara-subtitle {
        text-align: center;
        color: var(--tara-muted);
        font-size: 13.5px;
        line-height: 1.8;
        margin: 0 0 28px;
    }

    .tara-label {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #b8d4e8;
        margin: 0 0 8px;
    }

    .tara-field {
        position: relative;
        margin-bottom: 18px;
    }

    .tara-field-icon {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 17px;
        color: var(--tara-muted);
        z-index: 2;
        pointer-events: none;
    }

    .tara-input {
        width: 100%;
        height: 54px;
        border: 1px solid rgba(53, 213, 232, 0.2);
        border-radius: 14px;
        background: var(--tara-input-bg);
        padding: 0 48px 0 48px;
        color: #fff;
        font-size: 15px;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }

    .tara-input::placeholder {
        color: #6a8299;
    }

    .tara-input:focus {
        outline: 0;
        border-color: var(--tara-cyan);
        background: rgba(10, 30, 56, 0.85);
        box-shadow: 0 0 0 4px rgba(53, 213, 232, 0.15);
    }

    .tara-password-toggle {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        color: var(--tara-muted);
        padding: 8px;
        cursor: pointer;
        border-radius: 8px;
        transition: color 0.2s;
    }

    .tara-password-toggle:hover {
        color: var(--tara-cyan-bright);
    }

    .tara-remember {
        color: var(--tara-muted);
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        user-select: none;
    }

    .tara-remember input {
        width: 16px;
        height: 16px;
        accent-color: var(--tara-cyan);
        cursor: pointer;
    }

    .tara-submit {
        width: 100%;
        height: 54px;
        border: 0;
        border-radius: 14px;
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        background: linear-gradient(105deg, #1265b4 0%, #0d9ec4 50%, #17B8C5 100%);
        box-shadow: 0 10px 28px rgba(23, 184, 197, 0.3);
        transition: transform 0.2s, box-shadow 0.2s, filter 0.2s;
        cursor: pointer;
        margin-top: 8px;
    }

    .tara-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 36px rgba(23, 184, 197, 0.4);
        filter: brightness(1.05);
        color: #fff;
    }

    .tara-submit:active {
        transform: translateY(0);
    }

    .tara-submit:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
    }

    .tara-secure {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        color: var(--tara-muted);
        font-size: 12px;
        margin-top: 22px;
    }

    .tara-validation {
        color: #ff7b8a;
        font-size: 12px;
        margin-top: 6px;
        display: block;
    }

    @media (max-width: 991.98px) {
        .tara-login {
            grid-template-columns: 1fr;
        }
        .tara-visual {
            display: none;
        }
        .tara-form-side {
            min-height: 100vh;
            padding: 32px 20px;
            border-right: none;
            background: transparent;
        }
        .tara-card {
            max-width: 440px;
        }
    }

    @media (max-width: 480px) {
        .tara-card {
            padding: 26px 20px;
            border-radius: 20px;
        }
        .tara-title {
            font-size: 24px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            transition: none !important;
            animation: none !important;
        }
    }
</style>

<main class="tara-login" aria-labelledby="tara-login-title">

    <section class="tara-visual" aria-label="نمای کلی سامانه تراز آوا">
        <header class="tara-brand">
            <svg class="tara-brand-logo" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                    <linearGradient id="logoGrad" x1="0" y1="0" x2="72" y2="72">
                        <stop offset="0%" stop-color="#17B8C5"/>
                        <stop offset="55%" stop-color="#168CC7"/>
                        <stop offset="100%" stop-color="#0d6ea8"/>
                    </linearGradient>
                    <linearGradient id="logoAccent" x1="0" y1="72" x2="72" y2="0">
                        <stop offset="0%" stop-color="#35D5E8"/>
                        <stop offset="100%" stop-color="#17B8C5" stop-opacity="0.6"/>
                    </linearGradient>
                </defs>
                <rect x="4" y="4" width="64" height="64" rx="18" fill="url(#logoGrad)" opacity="0.95"/>
                <rect x="16" y="42" width="8" height="16" rx="2" fill="#fff" opacity="0.9"/>
                <rect x="28" y="32" width="8" height="26" rx="2" fill="#fff" opacity="0.95"/>
                <rect x="40" y="24" width="8" height="34" rx="2" fill="#fff"/>
                <rect x="52" y="18" width="8" height="40" rx="2" fill="url(#logoAccent)"/>
                <path d="M14 48 L26 38 L38 30 L50 20 L62 12" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.85"/>
                <path d="M56 10 L64 10 L64 18" stroke="#35D5E8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            <div>
                <div class="tara-brand-name">تراز آوا</div>
                <div class="tara-brand-caption">سامانه یکپارچه مدیریت مالی و حسابداری</div>
            </div>
        </header>

        <div class="tara-dashboard">
            <div class="tara-dash-header">
                <div>
                    <div class="tara-dash-title">نمای کلی عملکرد مالی</div>
                    <div class="tara-dash-sub">نمایش نمونه‌ای از گزارش‌های هوشمند سیستم</div>
                </div>
                <span class="tara-badge">
                    <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                    رشد ۷٫۴٪
                </span>
            </div>

            <div class="tara-stats">
                <div class="tara-stat">
                    <div class="tara-stat-label">درآمد ماه</div>
                    <div class="tara-stat-value">۸٫۲ میلیارد</div>
                    <div class="tara-stat-change">▲ ۱۲٫۵٪ نسبت به ماه قبل</div>
                </div>
                <div class="tara-stat">
                    <div class="tara-stat-label">هزینه ماه</div>
                    <div class="tara-stat-value">۳٫۷ میلیارد</div>
                    <div class="tara-stat-change" style="color:#f2a65a">▼ ۲٫۱٪ کاهش</div>
                </div>
                <div class="tara-stat">
                    <div class="tara-stat-label">سود خالص</div>
                    <div class="tara-stat-value">۴٫۵ میلیارد</div>
                    <div class="tara-stat-change">▲ ۱۸٪ رشد</div>
                </div>
            </div>

            <div class="tara-charts">
                <div class="tara-chart-panel">
                    <h4>روند درآمد و هزینه</h4>
                    <p>شش ماه اخیر (نمونه نمایشی)</p>
                    <svg class="tara-chart-svg" viewBox="0 0 420 160" role="img" aria-label="نمودار روند درآمد و هزینه">
                        <defs>
                            <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#35D5E8"/>
                                <stop offset="100%" stop-color="#168CC7" stop-opacity="0.7"/>
                            </linearGradient>
                            <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#17B8C5" stop-opacity="0.35"/>
                                <stop offset="100%" stop-color="#17B8C5" stop-opacity="0"/>
                            </linearGradient>
                        </defs>
                        <g stroke="rgba(53,213,232,0.08)" stroke-width="1">
                            <line x1="30" y1="20" x2="400" y2="20"/>
                            <line x1="30" y1="55" x2="400" y2="55"/>
                            <line x1="30" y1="90" x2="400" y2="90"/>
                            <line x1="30" y1="125" x2="400" y2="125"/>
                        </g>
                        <g fill="url(#barGrad)" opacity="0.9">
                            <rect x="48" y="95" width="28" height="30" rx="4"/>
                            <rect x="100" y="78" width="28" height="47" rx="4"/>
                            <rect x="152" y="88" width="28" height="37" rx="4"/>
                            <rect x="204" y="55" width="28" height="70" rx="4"/>
                            <rect x="256" y="62" width="28" height="63" rx="4"/>
                            <rect x="308" y="35" width="28" height="90" rx="4"/>
                            <rect x="360" y="42" width="28" height="83" rx="4"/>
                        </g>
                        <path d="M40 110 C70 105, 90 85, 120 92 S170 75, 210 58 S260 70, 300 38 S350 50, 400 28 L400 125 L40 125Z" fill="url(#areaGrad)"/>
                        <path d="M40 110 C70 105, 90 85, 120 92 S170 75, 210 58 S260 70, 300 38 S350 50, 400 28" fill="none" stroke="#35D5E8" stroke-width="2.8" stroke-linecap="round"/>
                        <path d="M40 122 C70 118, 90 112, 120 115 S170 105, 210 98 S260 108, 300 85 S350 95, 400 78" fill="none" stroke="#F2A65A" stroke-width="2.2" stroke-linecap="round"/>
                        <g fill="#7a95ad" font-size="10" text-anchor="middle">
                            <text x="62" y="148">فروردین</text>
                            <text x="166" y="148">خرداد</text>
                            <text x="270" y="148">مرداد</text>
                            <text x="374" y="148">مهر</text>
                        </g>
                    </svg>
                </div>

                <div class="tara-chart-panel">
                    <h4>ترکیب دارایی‌ها</h4>
                    <p>توزیع نمونه</p>
                    <svg class="tara-chart-svg" viewBox="0 0 180 140" role="img" aria-label="نمودار ترکیب دارایی‌ها">
                        <circle cx="90" cy="70" r="48" fill="none" stroke="rgba(53,213,232,0.1)" stroke-width="18"/>
                        <circle cx="90" cy="70" r="48" fill="none" stroke="#168CC7" stroke-width="18"
                                stroke-dasharray="180 301" stroke-dashoffset="0" transform="rotate(-90 90 70)"/>
                        <circle cx="90" cy="70" r="48" fill="none" stroke="#17B8C5" stroke-width="18"
                                stroke-dasharray="90 301" stroke-dashoffset="-180" transform="rotate(-90 90 70)"/>
                        <circle cx="90" cy="70" r="48" fill="none" stroke="#F2A65A" stroke-width="18"
                                stroke-dasharray="45 301" stroke-dashoffset="-270" transform="rotate(-90 90 70)"/>
                        <text x="90" y="66" text-anchor="middle" fill="#fff" font-size="16" font-weight="800">۶۲٪</text>
                        <text x="90" y="82" text-anchor="middle" fill="#8ba3bc" font-size="10">نقدینگی</text>
                    </svg>
                </div>
            </div>
        </div>

        <div class="tara-footer-note">
            <span>تراز آوا</span> — تصمیم‌های مالی دقیق‌تر با دیدی روشن‌تر
        </div>
    </section>

    <section class="tara-form-side">
        <div class="tara-card">
            <svg class="tara-form-logo" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                    <linearGradient id="logoGrad2" x1="0" y1="0" x2="72" y2="72">
                        <stop offset="0%" stop-color="#17B8C5"/>
                        <stop offset="55%" stop-color="#168CC7"/>
                        <stop offset="100%" stop-color="#0d6ea8"/>
                    </linearGradient>
                    <linearGradient id="logoAccent2" x1="0" y1="72" x2="72" y2="0">
                        <stop offset="0%" stop-color="#35D5E8"/>
                        <stop offset="100%" stop-color="#17B8C5" stop-opacity="0.6"/>
                    </linearGradient>
                </defs>
                <rect x="4" y="4" width="64" height="64" rx="18" fill="url(#logoGrad2)" opacity="0.95"/>
                <rect x="16" y="42" width="8" height="16" rx="2" fill="#fff" opacity="0.9"/>
                <rect x="28" y="32" width="8" height="26" rx="2" fill="#fff" opacity="0.95"/>
                <rect x="40" y="24" width="8" height="34" rx="2" fill="#fff"/>
                <rect x="52" y="18" width="8" height="40" rx="2" fill="url(#logoAccent2)"/>
                <path d="M14 48 L26 38 L38 30 L50 20 L62 12" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.85"/>
                <path d="M56 10 L64 10 L64 18" stroke="#35D5E8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>

            <h1 class="tara-title" id="tara-login-title">ورود به تراز آوا</h1>
            <p class="tara-subtitle">
                به سامانه یکپارچه مدیریت مالی و حسابداری خوش آمدید.<br />
                برای ادامه، اطلاعات حساب کاربری خود را وارد کنید.
            </p>

            <partial name="PartialViews/_DisplayPageMessages" />

            <form method="post" class="login-form">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="tara-validation" role="alert"></div>

                <div class="tara-field">
                    <label asp-for="ViewModel.Username" class="tara-label">نام کاربری</label>
                    <i class="bi bi-person tara-field-icon" aria-hidden="true"></i>
                    <input asp-for="ViewModel.Username"
                           class="tara-input"
                           placeholder="نام کاربری خود را وارد کنید"
                           autocomplete="username"
                           dir="ltr"
                           autofocus />
                    <span asp-validation-for="ViewModel.Username" class="tara-validation"></span>
                </div>

                <div class="tara-field">
                    <label asp-for="ViewModel.Password" class="tara-label">رمز عبور</label>
                    <i class="bi bi-lock tara-field-icon" aria-hidden="true"></i>
                    <input asp-for="ViewModel.Password"
                           id="login-password"
                           class="tara-input"
                           placeholder="رمز عبور خود را وارد کنید"
                           autocomplete="current-password"
                           dir="ltr" />
                    <button type="button"
                            class="tara-password-toggle"
                            data-password-toggle="login-password"
                            aria-controls="login-password"
                            aria-label="نمایش یا مخفی کردن رمز عبور">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                    <span asp-validation-for="ViewModel.Password" class="tara-validation"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                    <label class="tara-remember">
                        <input asp-for="ViewModel.RememberMe" />
                        مرا به خاطر بسپار
                    </label>
                </div>

                <button type="submit" class="btn tara-submit" data-login-submit>
                    <span class="login-submit-label">ورود به حساب کاربری</span>
                    <span class="spinner-border spinner-border-sm d-none me-2" data-login-spinner aria-hidden="true"></span>
                </button>
            </form>

            <div class="tara-secure">
                <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                ورود امن و رمزنگاری‌شده به فضای کاری شما
            </div>
        </div>
    </section>
</main>
