@page
@model Server.Pages.Security.LoginModel
@{
	var pageTitle = Resources.PageTitles.Login;
	var isRtl = System.Threading.Thread.CurrentThread.CurrentUICulture.TextInfo.IsRightToLeft;
	ViewData[Constants.ViewDataKeyName.PageTitle] = pageTitle;
	Layout = isRtl ? "Layouts/Rtl/_Security" : "Layouts/Ltr/_Security";
}

<main class="login-shell" aria-labelledby="login-title">
	<div class="login-orbit login-orbit-one" aria-hidden="true"></div>
	<div class="login-orbit login-orbit-two" aria-hidden="true"></div>

	<div class="container login-container">
		<div class="row g-0 login-panel">
			<section class="col-lg-6 login-brand-panel" aria-hidden="true">
				<div class="login-brand-content">
					<div class="login-mark"><i class="bi bi-bar-chart-line-fill"></i></div>
					<div class="login-signal">
						<span></span><span></span><span></span><span></span><span></span>
					</div>
				</div>
			</section>

			<section class="col-lg-6 login-form-panel">
				<div class="login-form-wrap">
					<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
						<div>
							<p class="login-kicker mb-2">@(pageTitle)</p>
							<h1 id="login-title" class="login-title mb-0">@(pageTitle)</h1>
						</div>
						<partial name="PartialViews/_ChangeCulture" />
					</div>

					<partial name="PartialViews/_DisplayPageMessages" />

					<form method="post" class="login-form">
						<input asp-for="ReturnUrl" type="hidden" />
						<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

						<div class="mb-3">
							<label asp-for="ViewModel.Username" class="form-label login-label"></label>
							<div class="login-input-group">
								<i class="bi bi-person login-input-icon" aria-hidden="true"></i>
								<input asp-for="ViewModel.Username" class="form-control login-input" autocomplete="username" dir="ltr" autofocus />
							</div>
							<span asp-validation-for="ViewModel.Username" class="field-validation-error"></span>
						</div>

						<div class="mb-3">
							<label asp-for="ViewModel.Password" class="form-label login-label"></label>
							<div class="login-input-group">
								<i class="bi bi-lock login-input-icon" aria-hidden="true"></i>
								<input asp-for="ViewModel.Password" id="login-password" class="form-control login-input login-password-input" autocomplete="current-password" dir="ltr" />
								<button type="button" class="login-password-toggle" data-password-toggle="login-password" aria-controls="login-password" aria-label="@(Resources.DataDictionary.Password)">
									<i class="bi bi-eye" aria-hidden="true"></i>
								</button>
							</div>
							<span asp-validation-for="ViewModel.Password" class="field-validation-error"></span>
						</div>

						<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
							<div class="form-check login-check">
								<input asp-for="ViewModel.RememberMe" class="form-check-input" />
								<label asp-for="ViewModel.RememberMe" class="form-check-label"></label>
							</div>
						</div>

						<button type="submit" class="btn login-submit w-100" data-login-submit>
							<span class="login-submit-label">@(Resources.ButtonCaptions.Login)</span>
							<span class="spinner-border spinner-border-sm d-none" data-login-spinner aria-hidden="true"></span>
						</button>
					</form>
				</div>
			</section>
		</div>
	</div>
</main>
