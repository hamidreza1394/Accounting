@page
@model Server.Pages.Account.LoginSuccessModel
@{
    var isRightToLeft = System.Threading.Thread.CurrentThread.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData[Constants.ViewDataKeyName.PageTitle] = isRightToLeft ? "ورود به حساب" : "Sign In";
    ViewData["BodyClass"] = "taraz-login-page";
    Layout = isRightToLeft ? "Layouts/Rtl/_Security" : "Layouts/Ltr/_Security";

    // The sign-in flow stores the confirmation in TempData, so it survives the redirect
    // (Post/Redirect/Get). A reload of this page has no pending message; the same text is
    // then read from the resources, so the page never becomes empty.
    var pageSuccesses = TempData[key: Infrastructure.Messages.MessageType.PageSuccess.ToString()] as System.Collections.Generic.IList<string>;

    var messages = (pageSuccesses != null && pageSuccesses.Count != 0)
        ? pageSuccesses
        : (System.Collections.Generic.IList<string>)new System.Collections.Generic.List<string>
        {
            Resources.Messages.Successes.LoginSucceededPendingFeatures
        };
}

@section StyleSheets {
    <link rel="stylesheet" href="~/css/rtl/taraz-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rtl/faranou-login-legacy-background.css" asp-append-version="true" />
    <style>
        /* A single, centered column: this page shows one confirmation only. */
        .taraz-login__shell.taraz-login__shell--single { grid-template-columns: minmax(0, 1fr); }
        .taraz-login__shell--single .taraz-login__panel { grid-column: 1 / -1; }
    </style>
}

<div class="taraz-login" dir="@(isRightToLeft ? "rtl" : "ltr")">
    <main class="taraz-login__shell taraz-login__shell--single" aria-labelledby="login-success-title">
        <section class="taraz-login__panel" aria-labelledby="login-success-title">
            <div class="taraz-panel-card">
                <div class="taraz-brand taraz-brand--form">
                    <img src="~/images/faranou-mark.svg" alt="" width="52" height="52" />
                    <div><strong>فرانو</strong><span>FARANOU — @(isRightToLeft ? "نرم‌افزار حسابداری هوشمند" : "Smart Accounting Software")</span></div>
                </div>

                <div class="taraz-form-heading">
                    <h1 id="login-success-title">@(isRightToLeft ? "ورود به حساب" : "Sign in")</h1>
                </div>

                <div class="taraz-form-status" role="status" aria-live="polite">
                    <div class="taraz-message taraz-message--success" role="status">
                        <ul class="mb-0">@foreach (var message in messages) { <li>@message</li> }</ul>
                    </div>
                </div>
            </div>

            <p class="taraz-copyright">© فرانو — @(isRightToLeft ? "نرم‌افزار حسابداری هوشمند" : "Smart Accounting Software")</p>
        </section>
    </main>
</div>
