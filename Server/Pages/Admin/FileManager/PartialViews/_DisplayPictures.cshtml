@model Server.Pages.Admin.FileManager.IndexModel
@inject Infrastructure.Settings.ApplicationSettings applicationSettings

@{
    if (Model == null || applicationSettings == null)
    {
        return;
    }

    string[] pictureExtensions = applicationSettings.FileManagerSettings.PictureExtensions;

    var files = Model.Files
        .Where(current => pictureExtensions.Contains(current.Extension.ToLowerInvariant()))
        .OrderBy(current => current.Extension)
        .ThenBy(current => current.Name)
        .ToList();

    if (files.Count == 0)
    {
        return;
    }
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" dir="ltr">
    @foreach (var item in files)
    {
        var pathName = $"{Model.CurrentPath}{item.Name}";

        <div class="col">
            <div class="card h-100 shadow-lg">
                <a href="@pathName" class="text-decoration-none" target="_blank" rel="noopener noreferrer">
                    <img src="@pathName"
                         class="card-img-top"
                         alt="@item.Name"
                         title="@item.Name"
                         loading="lazy"
                         style="max-height: 220px; object-fit: contain;" />
                </a>

                <div class="card-body">
                    <p class="card-text">
                        <strong>Length:</strong> @item.Length.ToString("#,##0")
                        <br />
                        <strong>Attributes:</strong> @item.Attributes
                    </p>
                </div>

                <div class="card-footer">
                    <h5 class="card-title mt-2">
                        <a href="@pathName" class="text-decoration-none" target="_blank" rel="noopener noreferrer">
                            @item.Name
                        </a>
                    </h5>
                </div>
            </div>
        </div>
    }
</div>
