@page
@using Infrastructure.DatabaseSetup
@model Server.Pages.DatabaseSetupModel
@{
    Layout = null;
    ViewData["Title"] = "راه‌اندازی پایگاه داده فرانو";
}
@functions {
    string FieldError(string field) =>
        ModelState.TryGetValue("Input." + field, out var entry) && entry.Errors.Count > 0
            ? string.Join(" ", entry.Errors.Select(error => error.ErrorMessage))
            : string.Empty;

    bool HasError(string field) => FieldError(field).Length > 0;

    // Server-rendered state (works without JS): aria-invalid, and the error id appended to the hint id.
    string? Invalid(string field) => HasError(field) ? "true" : null;

    string? Described(string field, string? hintId)
    {
        var ids = new List<string>();
        if (hintId is not null) ids.Add(hintId);
        if (HasError(field)) ids.Add("err-" + field);
        return ids.Count == 0 ? null : string.Join(" ", ids);
    }

    bool SqlMode => string.Equals(Model.Input.AuthenticationMode, "Sql", StringComparison.OrdinalIgnoreCase);

    static string StageLabel(DatabaseSetupStage stage) => stage switch
    {
        DatabaseSetupStage.Validating => "بررسی ورودی‌ها",
        DatabaseSetupStage.TestingConnection => "آزمایش اتصال",
        DatabaseSetupStage.Connected => "اتصال برقرار شد",
        DatabaseSetupStage.CreatingDatabase => "ساخت دیتابیس",
        DatabaseSetupStage.RunningMigrations => "اجرای Migrationها",
        DatabaseSetupStage.SavingSettings => "ذخیره تنظیمات",
        DatabaseSetupStage.Completed => "تکمیل",
        _ => stage.ToString()
    };

    static string StageState(DatabaseSetupStageStatus status) => status switch
    {
        DatabaseSetupStageStatus.Succeeded => "ok",
        DatabaseSetupStageStatus.Failed => "failed",
        _ => "skipped"
    };

    static string StageStateText(DatabaseSetupStageStatus status) => status switch
    {
        DatabaseSetupStageStatus.Succeeded => "انجام شد",
        DatabaseSetupStageStatus.Failed => "ناموفق",
        _ => "انجام نشد"
    };
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/rtl/fontiran.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/database-setup.css" asp-append-version="true" />
</head>
<body>
<main aria-labelledby="setup-title">
    <div class="brand">
        <img src="~/images/faranou-logo-mark.svg" alt="" width="26" height="32" />
        <strong>فرانو</strong><span lang="en" dir="ltr">Farano</span>
    </div>
    <h1 id="setup-title">راه‌اندازی پایگاه داده فرانو</h1>
    <p>اطلاعات اتصال به SQL Server را وارد کنید. ابتدا اتصال آزمایش می‌شود؛ سپس تنظیمات به‌صورت رمزنگاری‌شده در پوشهٔ تنظیمات همین سرور ذخیره می‌شود. فایل‌های داده (<span dir="ltr">.mdf/.ldf</span>) را خود SQL Server در پوشهٔ پیش‌فرض خودش می‌سازد (نام آن‌ها از نام دیتابیس گرفته می‌شود)؛ فرانو مسیری تعیین نمی‌کند و هیچ فایل دادهٔ موجودی را جابه‌جا یا حذف نمی‌کند.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert error" role="alert">
            <strong>@Model.ErrorMessage</strong>
            @if (!string.IsNullOrWhiteSpace(Model.FailureRemedy))
            {
                <span>@Model.FailureRemedy</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.TrackingId) && Model.ErrorMessage?.Contains(Model.TrackingId, StringComparison.Ordinal) != true)
            {
                <span class="tracking">شناسهٔ پیگیری: <code dir="ltr">@Model.TrackingId</code> — هنگام پیگیری، این شناسه را به پشتیبان بدهید؛ جزئیات فنی فقط در لاگ سرور ثبت شده است.</span>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.StatusTitle))
    {
        <div class="alert @(Model.IsBlocked ? "error" : "warning")" role="status">
            <strong>@Model.StatusTitle</strong>
            @if (!string.IsNullOrWhiteSpace(Model.StatusRemedy))
            {
                <span>@Model.StatusRemedy</span>
            }
            <span>پوشهٔ تنظیمات: <code dir="ltr">@Model.SettingsDirectory</code></span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert success" role="status">@Model.SuccessMessage</div>
    }
    @foreach (var warning in Model.Warnings)
    {
        <div class="alert warning" role="status">@warning</div>
    }

    @if (Model.StageOutcomes.Count > 0)
    {
        <ol class="steps" role="list" aria-label="مراحل راه‌اندازی">
            @foreach (var outcome in Model.StageOutcomes)
            {
                <li data-state="@StageState(outcome.Status)">@StageLabel(outcome.Stage): @StageStateText(outcome.Status)</li>
            }
        </ol>
    }

    @if (!Model.SettingsAlreadySaved && !Model.IsBlocked)
    {
        <div class="note">
            کد یک‌بارمصرف راه‌اندازی در فایل زیر روی همان سروری که برنامه اجرا می‌شود قرار دارد:
            <br /><code dir="ltr">@Model.SetupTokenFilePath</code>
            <br />این فایل را در اختیار دیگران قرار ندهید.
        </div>

        <form method="post" autocomplete="off" novalidate data-setup-form>
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <div class="grid">
                <div class="field wide">
                    <label asp-for="Input.SetupToken">کد راه‌اندازی</label>
                    <input asp-for="Input.SetupToken" data-field="SetupToken" autocomplete="off" dir="ltr" required aria-required="true" aria-invalid="@Invalid("SetupToken")" aria-describedby="@Described("SetupToken", null)" />
                    <span class="validation" id="err-SetupToken" data-error-for="SetupToken" hidden="@(FieldError("SetupToken").Length == 0)">@FieldError("SetupToken")</span>
                </div>
                <div class="field">
                    <label asp-for="Input.Server">سرور SQL Server</label>
                    <input asp-for="Input.Server" data-field="Server" dir="ltr" required aria-required="true" maxlength="256" placeholder="localhost" aria-invalid="@Invalid("Server")" aria-describedby="@Described("Server", "hint-Server")" />
                    <p class="hint" id="hint-Server">نام یا نشانی سرور؛ برای نمونهٔ نام‌دار <span dir="ltr">host\instance</span> و برای درگاه دیگر <span dir="ltr">host,1433</span>.</p>
                    <div class="chips" role="group" aria-label="نمونه‌های رایج">
                        <button type="button" class="chip" data-fill="localhost" data-target="Input_Server">localhost</button>
                        <button type="button" class="chip" data-fill=".\SQLEXPRESS" data-target="Input_Server">.\SQLEXPRESS</button>
                        <button type="button" class="chip" data-fill="host.docker.internal,1433" data-target="Input_Server">host.docker.internal,1433</button>
                    </div>
                    <span class="validation" id="err-Server" data-error-for="Server" hidden="@(FieldError("Server").Length == 0)">@FieldError("Server")</span>
                </div>
                <div class="field">
                    <label asp-for="Input.Database">نام دیتابیس</label>
                    <input asp-for="Input.Database" data-field="Database" dir="ltr" required aria-required="true" maxlength="123" aria-invalid="@Invalid("Database")" aria-describedby="@Described("Database", "hint-Database")" />
                    <p class="hint" id="hint-Database">اگر وجود نداشته باشد و گزینهٔ ساخت فعال باشد ساخته می‌شود؛ دیتابیس موجود هرگز حذف یا بازسازی نمی‌شود.</p>
                    <span class="validation" id="err-Database" data-error-for="Database" hidden="@(FieldError("Database").Length == 0)">@FieldError("Database")</span>
                </div>
                <div class="field wide">
                    <label asp-for="Input.AuthenticationMode">روش احراز هویت</label>
                    <select asp-for="Input.AuthenticationMode" data-field="AuthenticationMode" data-auth-mode aria-invalid="@Invalid("AuthenticationMode")" aria-describedby="@Described("AuthenticationMode", null)">
                        <option value="Windows">احراز هویت ویندوز (Windows Authentication)</option>
                        <option value="Sql">نام کاربری و رمز SQL Server</option>
                    </select>
                    <span class="validation" id="err-AuthenticationMode" data-error-for="AuthenticationMode" hidden="@(FieldError("AuthenticationMode").Length == 0)">@FieldError("AuthenticationMode")</span>
                </div>
                <div class="field" data-sql-only hidden="@(!SqlMode)">
                    <label asp-for="Input.UserName">نام کاربری SQL</label>
                    <input asp-for="Input.UserName" data-field="UserName" autocomplete="off" dir="ltr" maxlength="128" aria-invalid="@Invalid("UserName")" aria-describedby="@Described("UserName", null)" />
                    <span class="validation" id="err-UserName" data-error-for="UserName" hidden="@(FieldError("UserName").Length == 0)">@FieldError("UserName")</span>
                </div>
                <div class="field" data-sql-only hidden="@(!SqlMode)">
                    <label asp-for="Input.Password">رمز عبور SQL</label>
                    <div class="password-wrap">
                        <input asp-for="Input.Password" data-field="Password" type="password" autocomplete="new-password" dir="ltr" maxlength="256" aria-invalid="@Invalid("Password")" aria-describedby="@Described("Password", null)" />
                        <button type="button" class="toggle" data-toggle-password data-target="Input_Password" aria-pressed="false" aria-label="نمایش رمز عبور">نمایش</button>
                    </div>
                    <span class="validation" id="err-Password" data-error-for="Password" hidden="@(FieldError("Password").Length == 0)">@FieldError("Password")</span>
                </div>
                <div class="field wide options">
                    <label class="check">
                        <input asp-for="Input.CreateDatabaseIfMissing" />
                        <span>اگر دیتابیس وجود ندارد، آن را بساز و Migrationهای برنامه را اجرا کن</span>
                    </label>
                    <label class="check">
                        <input asp-for="Input.ContinuePartialMigrations" />
                        <span>اگر دیتابیس فرانو با Migrationهای ناتمام است (اجرای قبلی نیمه‌کاره مانده)، ادامهٔ Migrationها را مجاز کن</span>
                    </label>
                    <label class="check">
                        <input asp-for="Input.TrustServerCertificate" aria-describedby="hint-Trust" />
                        <span>اعتماد به گواهی سرور (TrustServerCertificate)</span>
                    </label>
                    <p class="hint" id="hint-Trust">اتصال همیشه رمزنگاری می‌شود. با فعال‌کردن این گزینه گواهی سرور بررسی نمی‌شود و اتصال در برابر جعل سرور (MITM) آسیب‌پذیر است؛ فقط برای SQL Server محلی یا آزمایشی با گواهی خودامضا. در محیط عملیاتی یک گواهی معتبر نصب کنید و این گزینه را خاموش بگذارید.</p>
                    @if (Model.RequiresReplaceConfirmation)
                    {
                        <label class="check">
                            <input asp-for="Input.ConfirmReplace" />
                            <span>فایل تنظیمات قبلی قابل استفاده نیست؛ جایگزینی آن را تأیید می‌کنم (نسخهٔ قبلی پیش از جایگزینی در پوشهٔ پشتیبان نگه داشته می‌شود).</span>
                        </label>
                        <span class="validation" id="err-ConfirmReplace" data-error-for="ConfirmReplace" hidden="@(FieldError("ConfirmReplace").Length == 0)">@FieldError("ConfirmReplace")</span>
                    }
                </div>
            </div>
            <button type="submit" data-submit data-busy-text="در حال بررسی اتصال و آماده‌سازی… لطفاً صبر کنید">آزمایش اتصال و ذخیره تنظیمات</button>
            <p class="sr-only" role="status" aria-live="polite" data-busy-status></p>
            <p class="sr-only" aria-live="polite" data-error-summary></p>
        </form>
    }

    @if (Model.ShowMasterBootstrap)
    {
        <h2>تنظیم مدیر زیرساختی (Master)</h2>
        <p>
            حساب مدیر زیرساختی در جدول کاربران ذخیره نمی‌شود و از
            <code dir="ltr">ApplicationSettings</code> خوانده می‌شود.
            رمز باید حداقل ۱۵ نویسه باشد؛ عبارت عبور مجاز است. برنامه رمز خام را ذخیره نمی‌کند و فقط هش استاندارد را برای قرار دادن در User Secrets یا متغیر محیطی آماده می‌کند.
        </p>
        <form method="post" asp-page-handler="PrepareMaster" autocomplete="off">
            <div class="grid">
                <div class="field wide">
                    <label asp-for="MasterInput.Username">نام کاربری مدیر زیرساختی</label>
                    <input asp-for="MasterInput.Username" autocomplete="username" dir="ltr" required />
                    <span asp-validation-for="MasterInput.Username" class="validation"></span>
                </div>
                <div class="field">
                    <label asp-for="MasterInput.Password">رمز عبور (حداقل ۱۵ نویسه)</label>
                    <input asp-for="MasterInput.Password" type="password" autocomplete="new-password" dir="ltr" required />
                    <span asp-validation-for="MasterInput.Password" class="validation"></span>
                </div>
                <div class="field">
                    <label asp-for="MasterInput.PasswordConfirmation">تکرار رمز عبور</label>
                    <input asp-for="MasterInput.PasswordConfirmation" type="password" autocomplete="new-password" dir="ltr" required />
                    <span asp-validation-for="MasterInput.PasswordConfirmation" class="validation"></span>
                </div>
            </div>
            <button type="submit">آماده‌سازی هش و دستورات پیکربندی</button>
        </form>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MasterDevelopmentCommands))
    {
        <div class="commands note" role="status">
            <h3>توسعه — User Secrets</h3>
            <p>پس از اجرای دستورات زیر، برنامه را Restart کنید. مقدار زیر <strong>هش</strong> است نه رمز خام.</p>
            <textarea readonly rows="4" aria-label="دستورات User Secrets">@Model.MasterDevelopmentCommands</textarea>
            <h3>تولید — متغیر محیطی / Secret Store</h3>
            <p>در Production مقادیر را در Secret Store یا متغیر محیطی میزبان قرار دهید (نه در فایل tracked).</p>
            <textarea readonly rows="3" aria-label="متغیرهای محیطی">@Model.MasterProductionVariables</textarea>
            <p>نام کاربری آماده‌شده: <code dir="ltr">@Model.MasterPreparedUsername</code></p>
        </div>
    }

    @if (Model.MasterAlreadyConfigured && Model.SettingsAlreadySaved)
    {
        <div class="note spaced">
            حساب زیرساختی از قبل در Configuration موجود است و از این صفحه تغییر داده نمی‌شود. برای چرخش رمز، Secret Store یا User Secrets را خارج از UI راه‌اندازی به‌روز کنید و برنامه را Restart کنید.
        </div>
    }
</main>
<script src="~/js/database-setup.js" asp-append-version="true"></script>
</body>
</html>
