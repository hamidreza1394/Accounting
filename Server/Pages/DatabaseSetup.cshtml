@page
@model Server.Pages.DatabaseSetupModel
@{
    Layout = null;
    ViewData["Title"] = "راه‌اندازی پایگاه داده تراز آوا";
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/database-setup.css" asp-append-version="true" />
</head>
<body>
<main>
    <h1>راه‌اندازی پایگاه داده تراز آوا</h1>
    <p>برای شروع، اطلاعات اتصال به SQL Server را وارد کنید. ابتدا اتصال آزمایش می‌شود؛ سپس تنظیمات به‌صورت رمزنگاری‌شده روی همین دستگاه ذخیره خواهد شد.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert error" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert success" role="status">@Model.SuccessMessage</div>
    }

    @if (!Model.SettingsAlreadySaved)
    {
        <div class="note">
            کد یک‌بارمصرف راه‌اندازی در فایل زیر روی همان سروری که برنامه اجرا می‌شود قرار دارد:
            <br /><code dir="ltr">@Model.SetupTokenFilePath</code>
            <br />این فایل را در اختیار دیگران قرار ندهید.
        </div>

        <form method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <div class="grid spaced">
                <div class="field wide">
                    <label asp-for="Input.SetupToken">کد راه‌اندازی</label>
                    <input asp-for="Input.SetupToken" autocomplete="off" required />
                    <span asp-validation-for="Input.SetupToken" class="validation"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Server">سرور SQL Server</label>
                    <input asp-for="Input.Server" dir="ltr" required />
                    <span asp-validation-for="Input.Server" class="validation"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Database">نام دیتابیس</label>
                    <input asp-for="Input.Database" dir="ltr" required />
                    <span asp-validation-for="Input.Database" class="validation"></span>
                </div>
                <div class="field wide">
                    <label asp-for="Input.AuthenticationMode">روش احراز هویت</label>
                    <select asp-for="Input.AuthenticationMode" id="authMode">
                        <option value="Windows">احراز هویت ویندوز (Windows Authentication)</option>
                        <option value="Sql">نام کاربری و رمز SQL Server</option>
                    </select>
                </div>
                <div class="field sql-only" id="sqlUserField" hidden>
                    <label asp-for="Input.UserName">نام کاربری SQL</label>
                    <input asp-for="Input.UserName" autocomplete="off" dir="ltr" />
                    <span asp-validation-for="Input.UserName" class="validation"></span>
                </div>
                <div class="field sql-only" id="sqlPasswordField" hidden>
                    <label asp-for="Input.Password">رمز عبور SQL</label>
                    <input asp-for="Input.Password" type="password" autocomplete="new-password" dir="ltr" />
                    <span asp-validation-for="Input.Password" class="validation"></span>
                </div>
                <div class="field wide">
                    <label class="check">
                        <input asp-for="Input.CreateDatabaseIfMissing" />
                        اگر دیتابیس وجود ندارد، آن را بساز و Migrationهای برنامه را اجرا کن
                    </label>
                    <label class="check">
                        <input asp-for="Input.TrustServerCertificate" />
                        اعتماد به گواهی سرور (فقط برای محیط‌های مورد اعتماد؛ در Production ترجیحاً خاموش باشد)
                    </label>
                </div>
            </div>
            <button type="submit">آزمایش اتصال و ذخیره تنظیمات</button>
        </form>
    }

    @if (Model.ShowMasterBootstrap)
    {
        <h2>تنظیم مدیر زیرساختی (Master)</h2>
        <p>
            حساب مدیر زیرساختی در جدول کاربران ذخیره نمی‌شود و از
            <code dir="ltr">ApplicationSettings</code> خوانده می‌شود.
            رمز باید حداقل ۱۵ نویسه باشد؛ عبارت عبور مجاز است. برنامه رمز خام را ذخیره نمی‌کند و فقط هش استاندارد را برای قرار دادن در User Secrets یا متغیر محیطی آماده می‌کند.
        </p>
        <form method="post" asp-page-handler="PrepareMaster" autocomplete="off">
            <div class="grid">
                <div class="field wide">
                    <label asp-for="MasterInput.Username">نام کاربری مدیر زیرساختی</label>
                    <input asp-for="MasterInput.Username" autocomplete="username" dir="ltr" required />
                    <span asp-validation-for="MasterInput.Username" class="validation"></span>
                </div>
                <div class="field">
                    <label asp-for="MasterInput.Password">رمز عبور (حداقل ۱۵ نویسه)</label>
                    <input asp-for="MasterInput.Password" type="password" autocomplete="new-password" dir="ltr" required />
                    <span asp-validation-for="MasterInput.Password" class="validation"></span>
                </div>
                <div class="field">
                    <label asp-for="MasterInput.PasswordConfirmation">تکرار رمز عبور</label>
                    <input asp-for="MasterInput.PasswordConfirmation" type="password" autocomplete="new-password" dir="ltr" required />
                    <span asp-validation-for="MasterInput.PasswordConfirmation" class="validation"></span>
                </div>
            </div>
            <button type="submit">آماده‌سازی هش و دستورات پیکربندی</button>
        </form>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MasterDevelopmentCommands))
    {
        <div class="commands note" role="status">
            <h3>توسعه — User Secrets</h3>
            <p>پس از اجرای دستورات زیر، برنامه را Restart کنید. مقدار زیر <strong>هش</strong> است نه رمز خام.</p>
            <textarea readonly rows="4" aria-label="دستورات User Secrets">@Model.MasterDevelopmentCommands</textarea>
            <h3>تولید — متغیر محیطی / Secret Store</h3>
            <p>در Production مقادیر را در Secret Store یا متغیر محیطی میزبان قرار دهید (نه در فایل tracked).</p>
            <textarea readonly rows="3" aria-label="متغیرهای محیطی">@Model.MasterProductionVariables</textarea>
            <p>نام کاربری آماده‌شده: <code dir="ltr">@Model.MasterPreparedUsername</code></p>
        </div>
    }

    @if (Model.MasterAlreadyConfigured && Model.SettingsAlreadySaved)
    {
        <div class="note spaced">
            حساب زیرساختی از قبل در Configuration موجود است و از این صفحه تغییر داده نمی‌شود. برای چرخش رمز، Secret Store یا User Secrets را خارج از UI راه‌اندازی به‌روز کنید و برنامه را Restart کنید.
        </div>
    }
</main>
<script src="~/js/database-setup.js" asp-append-version="true"></script>
</body>
</html>
