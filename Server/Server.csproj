<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<TargetFramework>net10.0</TargetFramework>
		<UserSecretsId>daa73122-0229-45ab-8b25-e37e15dce0de</UserSecretsId>
		<!--<ImplicitUsings>enable</ImplicitUsings>-->
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Pages\Admin\ApplicationHandlers\cyplncat.hzs~" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Application\Application.csproj" />
		<ProjectReference Include="..\Infrastructure\Persistence\Infrastructure.Persistence.csproj" />
		<ProjectReference Include="..\Dtat.Seedwork.Abstractions\Dtat.Seedwork.Abstractions.csproj" />
		<ProjectReference Include="..\Dtat\Dtat.csproj" />
		<ProjectReference Include="..\Domain\Domain.csproj" />
		<ProjectReference Include="..\Constants\Constants.csproj" />
		<ProjectReference Include="..\Resources\Resources.csproj" />
		<ProjectReference Include="..\ViewModels\ViewModels.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!--
		Visual Studio F5 must not start a server whose React route will 404 on a fresh checkout.
		The client output is generated/ignored; build it incrementally for regular VS builds.
		CLI and CI builds keep using the explicit scripts/publish.sh / npm workflow.
	-->
	<ItemGroup Condition="'$(BuildingInsideVisualStudio)' == 'true'">
		<FaranouClientBuildInput Include="$(MSBuildProjectDirectory)/../ClientApp/**/*"
			Exclude="$(MSBuildProjectDirectory)/../ClientApp/node_modules/**/*;$(MSBuildProjectDirectory)/../ClientApp/.vite/**/*" />
	</ItemGroup>

	<Target Name="FaranouBuildClientAppForVisualStudio"
		BeforeTargets="Build"
		Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(FaranouSkipClientAppBuild)' != 'true'"
		Inputs="@(FaranouClientBuildInput)"
		Outputs="$(MSBuildProjectDirectory)/wwwroot/app/index.html">
		<PropertyGroup>
			<FaranouClientAppDirectory>$(MSBuildProjectDirectory)/../ClientApp</FaranouClientAppDirectory>
		</PropertyGroup>
		<Error Condition="!Exists('$(FaranouClientAppDirectory)/package.json')"
			Text="Farano ClientApp/package.json was not found. Restore the complete repository before building the Server project." />
		<Exec Command="npm ci --no-fund --no-audit"
			WorkingDirectory="$(FaranouClientAppDirectory)"
			Condition="!Exists('$(FaranouClientAppDirectory)/node_modules/.package-lock.json')" />
		<Exec Command="npm run build" WorkingDirectory="$(FaranouClientAppDirectory)" />
		<Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/app/index.html')"
			Text="Farano React build did not produce Server/wwwroot/app/index.html. Check the npm build output." />
	</Target>

	<!--
		A published server must contain the built React client (wwwroot/app), otherwise /app
		answers 404 in production. Build it first with scripts/publish.sh (or publish.ps1), which
		runs npm ci, the type check, the tests and npm run build in ClientApp before publishing.
		Pass -p:FaranouSkipClientAppCheck=true only for a deliberate server-only publish.
	-->
	<Target Name="FaranouEnsureClientAppBuilt" BeforeTargets="PrepareForPublish" Condition="'$(FaranouSkipClientAppCheck)' != 'true'">
		<Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/app/index.html')"
			Text="The React client is not built (Server/wwwroot/app/index.html is missing). Run scripts/publish.sh (or: cd ClientApp; npm ci; npm run build) before 'dotnet publish', or pass -p:FaranouSkipClientAppCheck=true for a server-only publish." />
	</Target>

</Project>
