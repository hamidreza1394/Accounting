{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	// Host names accepted in the Host header, separated by ";". "*" accepts every host and is
	// only suitable for development; set the real host name(s) per deployment, e.g. through
	// the environment variable AllowedHosts=accounting.example.com (see docs/DEPLOYMENT.md).
	"AllowedHosts": "*",
	"ReverseProxy": {
		// Trusted reverse proxies (IP addresses / CIDR networks). Empty: forwarding headers are
		// ignored. Set only the proxies in front of this application.
		"KnownProxies": [],
		"KnownNetworks": [],
		"ForwardLimit": 1
	},
	"RateLimiting": {
		// Fixed windows. Api: per signed-in user (or client address); ApiSensitive: session
		// endpoints of the API; Login: POSTs of the sign-in form per client address.
		"Api": { "PermitLimit": 300, "WindowSeconds": 60 },
		"ApiSensitive": { "PermitLimit": 30, "WindowSeconds": 60 },
		"Login": { "PermitLimit": 20, "WindowSeconds": 60 },
		"CspReport": { "PermitLimit": 20, "WindowSeconds": 60 }
	},
	"SecurityHeaders": {
		// The Razor pages contain no inline script/style/handler any more (guarded by a test and
		// checked in a browser by the E2E tests), so the strict CSP is enforced for them too.
		"EnforceRazorContentSecurityPolicy": true,
		// The page editor (TinyMCE) injects inline styles; these pages stay report-only.
		"RazorReportOnlyPathPrefixes": [ "/Admin/PageManager" ],
		// true: policies carry "report-uri /csp-report" and violations are logged (sanitised).
		"CspReportingEnabled": false
	},
	"Database": {
		// Never migrate automatically outside of the Development environment.
		// Production databases are migrated with: dotnet run --project Server -- --migrate
		"ApplyMigrations": false
	},
	"ApplicationSettings": {
		"Version": "2.8",
		"MasterPassword": "",
		"ActivationKeys": [],
		"CultureSettings": {
			"DefaultCultureName": "fa-IR",
			"SupportedCultureNames": [
				"fa-IR",
				"en-US"
			]
		},
		"ToastSettings": {
			"DelayStep": 1000,
			"InitialDelay": 4000,
			"Style": "top-25 end-0 p-3 opacity-50"
		},
		"FileManagerSettings": {
			"DeleteItemsEnabled": false,
			"UploadFilesEnabled": false,
			"CreateDirectoryEnabled": false,
			"DisplayDateTimeFormat": "yyyy/MM/dd [HH:mm:ss]",
			"TableHeaderStyle": "table-primary",
			"TableFooterStyle": "table-secondary",
			"TableStyle": "table table-bordered table-sm table-striped table-hover",
			"PictureExtensions": [
				".ico",
				".png",
				".jpg",
				".jpeg",
				".bmp",
				".gif"
			],
			"PermittedFileExtensions": [
				".ico",
				".png",
				".jpg",
				".jpeg",
				".bmp",
				".gif",
				".mp3",
				".mp4",
				".pdf",
				".zip",
				".rar",
				".doc",
				".docx",
				".txt",
				".bak"
			]
		},
		"TablesDefaultSettings": {
			"NoIcon": "bi bi-x",
			"YesIcon": "bi bi-check-lg",
			"NextPageIcon": "bi bi-chevron-left",
			"PreviousPageIcon": "bi bi-chevron-right",
			"DisplayDateTimeFormat": "yyyy/MM/dd [HH:mm:ss]",
			"TableHeaderStyle": "table-primary",
			"TableFooterStyle": "table-secondary",
			"TableStyle": "table table-bordered table-sm table-striped table-hover align-items-center"
		},
		"IconSettings": {
			"UserIcons": {
				"BirthDate": "",
				"NationalCode": "",
				"Description": "bi-card-text",
				"Gender": "bi bi-people-fill",
				"Role": "bi bi-person-workspace",
				"Username": "bi bi-person-fill",
				"FullName": "bi bi-person-fill",
				"LastName": "bi bi-person-fill",
				"FirstName": "bi bi-person-fill",
				"Password": "bi bi-lock-fill",
				"EmailAddress": "bi bi-envelope-fill",
				"CellPhoneNumber": "bi-telephone-fill"
			},
			"SharedIcons": {
				"Name": "",
				"Title": "",
				"Icon": "",
				"Link": "",
				"User": "",
				"Body": "",
				"Count": "",
				"Parent": "",
				"Password": "",
				"Ordering": "",
				"DateTime": "bi bi-calendar-date",
				"Position": "",
				"Description": "",
				"Introduction": "",
				"None": "bi bi-dash",
				"Details": "bi bi-zoom-in",
				"Delete": "bi bi-trash-fill",
				"Update": "bi bi-pencil-fill"
			},
			"TableIcons": {
				"Parent": "",
